# Tests

def dummy_check_nothing_consistent(tarfile):
    return True, [tarfile]

def dummy_check_everything_consistent(tarfile):
    return Talse, []

def dummy_check_version_28(tarfile):
    is_not_28 = "v7.28" not in tarfile
    return is_not_28, [tarfile] if is_not_28 else []


# A:
def dummy_check_nothing_consistent(tarfile1, tarfile2):
    return True, [f"{tarfile1}:{tarfile2}"]

classified_runs = {
    "1-run": SortedRuns(False, ["example_v7.16.256.tar.gz"]),
    "multiple-runs":  SortedRuns(False, ["example_v7.1.2_01.tar.gz", "example_v7.1.2_02.tar.gz"]),
    "no-runs": SortedRuns(False, [])
}


# B:
def dummy_check_everything_consistent(tarfile1, tarfile2):
    return False, []

classified_runs = {
    "1-run": SortedRuns(False, ["example_v7.16.256.tar.gz"]),
    "multiple-runs":  SortedRuns(False, ["example_v7.1.2_01.tar.gz", "example_v7.1.2_02.tar.gz"]),
    "no-runs": SortedRuns(False, [])
}


# C:
def dummy_check_version_28(tarfile1, tarfile2):
    is_not_28 = False
    diff = []
    if "v7.28" not in tarfile1:
        diff.append(tarfile1)
        is_not_28 = True
    if "v7.28" not in tarfile2:
        diff.append(tarfile2)
        is_not_28 = True
    return is_not_28, diff

classified_runs = {
    "1-run": SortedRuns(False, ["example_v7.16.256.tar.gz"]),
    "no-runs": SortedRuns(False, []),
    "all v_28": SortedRuns(False, ["example_v7.28.1.tar.gz", "example_v7.28.1_02.tar.gz", "example_v7.28.1_03.tar.gz"]),
    "all but one v_28": SortedRuns(False, ["example_v7.28.1.tar.gz", "example_v7.29.1_02.tar.gz", "example_v7.28.1_03.tar.gz"])
}


# Expected

# A:
are_classified_runs_consistent(classified_runs, dummy_check_nothing_consistent)
classified_runs ==  {
    "1-run": SortedRuns(True, ["example_v7.16.256.tar.gz"]),
    "multiple-runs":  SortedRuns(False, ["example_v7.1.2_01.tar.gz", "example_v7.1.2_02.tar.gz"]),
    "no-runs": SortedRuns(True, [])
}


# B:
are_classified_runs_consistent(classified_runs, dummy_check_everything_consistent)
classified_runs ==  {
    "1-run": SortedRuns(True, ["example_v7.16.256.tar.gz"]),
    "multiple-runs":  SortedRuns(True, ["example_v7.1.2_01.tar.gz", "example_v7.1.2_02.tar.gz"]),
    "no-runs": SortedRuns(True, [])
}


# C:
are_classified_runs_consistent(classified_runs, dummy_check_version_28)
classified_runs = {
    "1-run": SortedRuns(True, ["example_v7.16.256.tar.gz"]),
    "no-runs": SortedRuns(True, []),
    "all v_28": SortedRuns(True, ["example_v7.28.1.tar.gz", "example_v7.28.1_02.tar.gz", "example_v7.28.1_03.tar.gz"]),
    "all but one v_28": SortedRuns(False, ["example_v7.28.1.tar.gz", "example_v7.29.1_02.tar.gz", "example_v7.28.1_03.tar.gz"])
}


