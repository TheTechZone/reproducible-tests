# Tests

def dummy_check_nothing_consistent(tarfile1, tarfile2):
    return True, [f"{tarfile1}:{tarfile2}"]
	
def dummy_check_everything_consistent(tarfile1, tarfile2):
    return False, []

# A, B:
classified_runs = {
    "1-run": SortedRuns(True, ["example_v7.16.256.tar.gz"]),
    "no-runs": SortedRuns(True, []),
    "all v_28": SortedRuns(True, ["example_v7.28.1.tar.gz", "example_v7.28.1_02.tar.gz", "example_v7.28.1_03.tar.gz"]),
    "all but one v_28": SortedRuns(True, ["example_v7.28.1.tar.gz", "example_v7.29.1_02.tar.gz", "example_v7.28.1_03.tar.gz"])
}

# C:
def dummy_check_version_28(tarfile1, tarfile2):
    is_not_28 = False
    diff = []
    if "v7.28" not in tarfile1:
        diff.append(tarfile1)
        is_not_28 = True
    if "v7.28" not in tarfile2:
        diff.append(tarfile2)
        is_not_28 = True
    return is_not_28, diff

classified_runs = {
    "1-run": SortedRuns(True, ["example_v7.16.256.tar.gz"]),
    "no-runs": SortedRuns(True, []),
    "all v_28": SortedRuns(True, ["example_v7.28.1.tar.gz", "example_v7.28.1_02.tar.gz", "example_v7.28.1_03.tar.gz"]),
    "more_v_28": SortedRuns(True, ["example_v7.28.1.tar.gz", "example_v7.29.1_02.tar.gz", "example_v7.28.1_03.tar.gz"])
}

# Expected

# A:
_compare_amongst_runs(classified_runs, "all v_28", dummy_check_everything_consistent)
